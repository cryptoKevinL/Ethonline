# ============================================
# Crypto Payment Gateway — Environment Config
# ============================================
# Copy to .env and fill in actual values
# NEVER commit .env to version control
# ============================================

# ── App ──
NODE_ENV=development
APP_URL=http://localhost:3000
APP_SECRET=your-app-secret-here
SESSION_SECRET=your-session-secret-here
PORT=3000

# ── Database ──
DATABASE_URL=postgresql://user:password@localhost:5432/payments_db
REDIS_URL=redis://localhost:6379

# ── Stripe ──
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Crypto / Web3 ──
ALCHEMY_API_KEY=your-alchemy-key
INFURA_PROJECT_ID=your-infura-project-id
INFURA_API_SECRET=your-infura-secret
ETHERSCAN_API_KEY=your-etherscan-key
COINMARKETCAP_API_KEY=your-cmc-key
HOT_WALLET_PRIVATE_KEY=0x_your_hot_wallet_private_key
COLD_WALLET_ADDRESS=0x_your_cold_wallet_address
CHAIN_ID=1
RPC_ENDPOINT=https://eth-mainnet.g.alchemy.com/v2/your-key

# ── Google OAuth / Service Account (Gmail, Sheets, Calendar) ──
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_ACCESS_TOKEN=ya29.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_SERVICE_ACCOUNT_EMAIL=agent@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/service-account.json

# ── AWS ──
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=payments-uploads
AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789:key/your-kms-key-id

# ── AI / LLM ──
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGCHAIN_API_KEY=ls__xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=crypto-payments

# ── Agent Sandbox ──
AGENT_WORKSPACE=/workspace
AGENT_EXECUTION_MODE=sandboxed
AGENT_MAX_TOOL_CALLS=50
AGENT_MEMORY_BACKEND=redis
AGENT_LOG_LEVEL=debug

# ── Vercel ──
VERCEL_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
VERCEL_ORG_ID=team_xxxxxxxxxxxxxxxxxxxx
VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxxxxxxxxx

# ── GitHub ──
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_WEBHOOK_SECRET=your-webhook-secret
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_PATH=./credentials/github-app.pem

# ── Slack (notifications) ──
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SLACK_CHANNEL_ALERTS=#payments-alerts

# ── Twilio (SMS alerts) ──
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ── Monitoring ──
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
DATADOG_API_KEY=your-datadog-key
PAGERDUTY_INTEGRATION_KEY=your-pagerduty-key

# ── Email (SMTP fallback) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ── Feature Flags ──
ENABLE_MAINNET=false
ENABLE_AUTO_SETTLEMENT=false
ENABLE_WEBHOOK_RETRY=true
MAX_TRANSACTION_USD=10000
